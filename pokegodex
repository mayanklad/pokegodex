#!/usr/bin/env zsh
[[ -n "$POKEGODEX_RUNNING" ]] && return
POKEGODEX_PATH="$HOME/.local/share/pokegodex"
POKEDEX_FILE="$HOME/.local/share/pokegodex/pokedex.txt"
POKEDEX_HASH="$POKEDEX_FILE.sha256"
SORTED_FILE="$HOME/.local/share/pokegodex/pokedex_sorted.txt"
GEN_DIR="$HOME/.local/share/pokegodex/gen_files"
VERSION_DIRECTORY="$HOME/.local/share/pokegodex/VERSION"
GEN_COLLECTION_DEFAULT="1-8"
GEN_COLLECTION="$GEN_COLLECTION_DEFAULT"

# === MAKE POKEDEX FILE IF IT DOESNT EXIST ===
mkdir -p "$(dirname "$POKEDEX_FILE")"
touch "$POKEDEX_FILE"
chmod 444 "$POKEDEX_FILE"

usage() {
    cat <<'EOF'
pokegodex - Pokemon terminal collection tool

Usage:
  pokegodex [OPTIONS]

Options:
  -h, --help           Show this help message
  -v, --version        Show pokegodex version
  -g, --gen N|N-M      Use a specific generation or range (1–8)
  -r, --remove NAME    Remove a Pokemon from the Pokedex
  -f, --fix-pokedex    Repair Pokedex after removal

Examples:
  pokegodex --version
  pokegodex --gen 1
  pokegodex --gen 2-5
  pokegodex --remove pikachu
  pokegodex --fix-pokedex
EOF
}

case "$1" in
    -h|--help)
        usage
        return 1
        ;;
    -v|--version)
        echo "Version: $(cat $VERSION_DIRECTORY)"
        return 1
        ;;
    -g|--gen)
        gen="$2"

        [[ "$gen" =~ ^[0-9]+(-[0-9]+)?$ ]] || {
            echo "Error: --gen must be N or N-M (1–8)"
            return 1
        }

        IFS=- read -r start end <<< "$gen"
        end=${end:-$start}

        (( start >= 1 && end <= 8 && start <= end )) || {
            echo "Error: generations must be between 1 and 8"
            return 1
        }

        GEN_COLLECTION="$gen"
        ;;
    -r|--remove)
        if [[ -n "$2" ]]; then
            if [[ -f "$POKEDEX_HASH" ]]; then
                if command -v sha256sum >/dev/null 2>&1; then
                    sha256sum -c "$POKEDEX_HASH" >/dev/null 2>&1 || true
                else
                    shasum -a 256 -c "$POKEDEX_HASH" >/dev/null 2>&1 || { echo "Pokedex modified outside pokegodex, please use 'pokegodex --remove \"YOUR_ADDED_POKEMON\"' to move the manually added pokemon from the pokedex."; return 1; }
                fi
            fi

            if ! grep -Fqi "$2 " "$POKEDEX_FILE"; then
                echo "Pokemon '$2' not found in pokedex"
                return 1
            fi

            chmod 644 "$POKEDEX_FILE"
            grep -Fvi "$2 " "$POKEDEX_FILE" > "$SORTED_FILE" &&
            command mv -f "$SORTED_FILE" "$POKEDEX_FILE"
            chmod 444 "$POKEDEX_FILE"

            if command -v sha256sum >/dev/null 2>&1; then
                sha256sum "$POKEDEX_FILE" > "$POKEDEX_HASH"
            else
                shasum -a 256 "$POKEDEX_FILE" > "$POKEDEX_HASH"
            fi

            return 0
        else 
            echo "ERROR: Please specify a pokemon to remove from the pokedex e.g. pokegodex --remove pikachu"
            return 0
        fi
        ;;
    -f|--fix-pokedex)
        if command -v sha256sum >/dev/null 2>&1; then
            sha256sum "$POKEDEX_FILE" > "$POKEDEX_HASH"
        else
            shasum -a 256 "$POKEDEX_FILE" > "$POKEDEX_HASH"
        fi
        return 0
esac

if [[ -f "$POKEDEX_HASH" ]]; then
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum -c "$POKEDEX_HASH" >/dev/null 2>&1 || { echo "Pokedex modified outside pokegodex, please use 'pokegodex --remove \"YOUR_ADDED_POKEMON\"' to move the manually added pokemon from the pokedex."; return 1; }
    else
        shasum -a 256 -c "$POKEDEX_HASH" >/dev/null 2>&1 || { echo "Pokedex modified outside pokegodex, please use 'pokegodex --remove \"YOUR_ADDED_POKEMON\"' to move the manually added pokemon from the pokedex."; return 1; }
    fi
fi

# === PICK A RANDOM POKEMON FROM THE SELECTED GENERATION RANGE OURSELVES ===
IFS=- read -r gstart gend <<< "$GEN_COLLECTION"
gend=${gend:-$gstart}

gen_pool_files=()
for ((g=gstart; g<=gend; g++)); do
    gen_pool_files+=("$GEN_DIR/gen${g}_list.txt")
done

base_name=$(cat "${gen_pool_files[@]}" 2>/dev/null | shuf -n 1)

if [[ -z "$base_name" ]]; then
    echo "pokegodex: could not pick a pokemon for generation range '$GEN_COLLECTION'"
    return 1
fi

raw_output=$(pokego --name "$base_name")
name=$(echo "$raw_output" | head -n 1)
sprite=$(echo "$raw_output" | tail -n +2)

# === SHINY ROLL (1/4096 or 1/10 if THAT generation complete) ===

pokemon_gen=""

for GEN_FILE in "$GEN_DIR"/gen*_list.txt; do
    if grep -qx "$base_name" "$GEN_FILE"; then
        pokemon_gen="$GEN_FILE"
        break
    fi
done

gen_complete=false

if [[ -n "$pokemon_gen" ]]; then
    total=$(wc -l < "$pokemon_gen")

    caught=$(awk '
        NR==FNR { gen[$0]=1; next }
        {
            n=$0
            sub(/[ \t]+[0-9]+$/, "", n)
            if (n in gen) seen[n]=1
        }
        END { print length(seen) }
    ' "$pokemon_gen" "$POKEDEX_FILE")

    (( caught == total )) && gen_complete=true
fi

if $gen_complete; then
    (( RANDOM % 10 == 0 )) && shiny=true || shiny=false
else
    (( RANDOM % 4096 == 0 )) && shiny=true || shiny=false
fi

# === FETCH SHINY IF NEEDED ===
if [ "$shiny" = true ]; then
    raw_output=$(pokego --name "$base_name" --shiny)
    sprite=$(echo "$raw_output" | tail -n +2)
fi

# === FORMAT NAME FOR POKEDEX STORAGE ===
if [ "$shiny" = true ]; then
    stored_name="${base_name} (shiny)"
    display_name="\033[33m${base_name} (shiny)\033[0m"
else
    stored_name="$base_name"
    display_name="$base_name"
fi

# === AWARD XP ===
# Normal: 10 XP | Shiny: 150 XP
if [ "$shiny" = true ]; then
    xp_to_add=150
else
    xp_to_add=10
fi

PYTHONPATH="$POKEGODEX_PATH" python3 -c "
from trainer import add_xp, update_streak
from achievements import check_pokedex_achievements, update_daily_catch
add_xp($xp_to_add)
update_streak()
update_daily_catch()
check_pokedex_achievements()
" 2>/dev/null & 

image_source="$(echo -e "$sprite\n$display_name")"

chmod 644 "$POKEDEX_FILE"

# === UPDATE POKEDEX WITH COUNT ===
awk -v n="$stored_name" '
{
    if ($NF ~ /^[0-9]+$/) {
        count = $NF
        name = substr($0, 1, length($0)-length($NF))
        sub(/[ \t]+$/, "", name)
    } else {
        name = $0
        count = 0
    }

    if (name == n) {
        count++
        found=1
    }

    print name, count
}
END {
    if (!found) print n,1
}
' "$POKEDEX_FILE" > "$SORTED_FILE" && command mv -f "$SORTED_FILE" "$POKEDEX_FILE"

# === SORT POKEDEX BY GENERATION ORDER ===
for GEN_FILE in "$GEN_DIR"/gen*_list.txt; do
    if grep -qx "$base_name" "$GEN_FILE"; then
        awk '
            NR==FNR { order[$0]=NR; next }
            {
                line=$0
                base=$0
                sub(/ \(shiny\)$/, "", base)
                sort_order = (base in order) ? order[base] : 9999
                print sort_order "\t" line
            }
        ' "$GEN_FILE" "$POKEDEX_FILE" \
        | sort -n \
        | cut -f2- > "$SORTED_FILE"
        command mv -f "$SORTED_FILE" "$POKEDEX_FILE"
        break
    fi
done

chmod 444 "$POKEDEX_FILE"

if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$POKEDEX_FILE" > "$POKEDEX_HASH"
else
    shasum -a 256 "$POKEDEX_FILE" > "$POKEDEX_HASH"
fi

# === SHOW IMAGE IN FASTFETCH ===
POKEGODEX_RUNNING=1 fastfetch --file-raw - <<< "$image_source"
